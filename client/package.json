{
  "name": "clean-version",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "lodash.get": "^4.4.2",
    "lodash.omit": "^4.5.0",
    "lodash.remove": "^4.7.0",
    "lodash.truncate": "^4.4.2",
    "querystring": "^0.2.0",
    "react": "^16.14.0",
    "react-copy-to-clipboard": "^5.0.4",
    "react-dom": "^16.14.0",
    "react-favicon": "^0.0.14",
    "react-loading-skeleton": "^2.2.0",
    "react-qr-code": "^2.0.2",
    "react-range": "^1.8.7",
    "react-reveal": "^1.2.2",
    "react-router-dom": "^5.0.1",
    "react-scripts": "3.4.4",
    "react-share": "^4.4.0",
    "tiny-human-time": "^1.2.0",
    "babel-jest": "24.7.1"
  },
  "scripts": {
    "start:prod": "REACT_APP_ENV=PROD react-scripts start",
    "start:stg": "REACT_APP_ENV=STAG react-scripts start",
    "start:dev": "REACT_APP_ENV=DEV react-scripts start",
    "dev": "REACT_APP_ENV=DEV react-scripts start",
    "start": "react-scripts start --openssl-legacy-provide",
    "build": "react-scripts build --openssl-legacy-provide",
    "lint": "eslint src",
    "test": "SKIP_PREFLIGHT_CHECK=true react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app",
    "rules": {
      "semi": [
        2,
        "never"
      ]
    }
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@types/lodash.remove": "^4.7.6",
    "@types/react": "^17.0.11",
    "sass": "^1.77.0",
    "react-testing-library": "^5.9.0",
    "typescript": "4.4.4"
  }
}
